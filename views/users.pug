html
    head
        title Страница со всеми пользователями
        style.
            .course-card {
                border: 1px solid #ccc;
                padding: 10px;
                margin-bottom: 10px;
                border-radius: 5px;
                background-color: #f9f9f9;
            }
            .course-card div {
                margin: 3px 0;
            }
    body
        header
            if user
                div.user-panel
                    div #{user.username}
                    a.js-auth(href="#") Выйти
            else
                a(href="/auth") Войти | Регистрация
            h1 Страница со всеми пользователями

        each user in data
            div.course-card
                div Имя пользователя: #{user.username}
                div Email: #{user.email}
                div Права: #{user.role}

        script(src="/js/script.js")