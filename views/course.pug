html
    include head
    body
        header
            if user
                div.user-panel
                    div #{user.username}
                    a.js-auth(href="#") Выйти
            else
                a(href="/auth") Войти | Регистрация
            h1 Страница со всеми курсами

        each course in data
            div.course-card
                div Название курса: #{course.title}
                div Описание: #{course.description}
                div Сложность: #{course.difficulty}
                div Теги: #{course.tags.join(', ')}
                div Автор: #{course.author_id.username}
    include footer