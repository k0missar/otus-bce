html
    head
        title Детальная страница с курсом #{data.title}
        style.
            .course-card {
                border: 1px solid #ccc;
                padding: 10px;
                margin-bottom: 10px;
                border-radius: 5px;
                background-color: #f9f9f9;
            }
            .course-card div {
                margin: 3px 0;
            }
    body
        h1 Детальная страница с курсом #{data.title}
            div.course-card
                div Название курса: #{data.title}
                div Описание: #{data.description}
                div Сложность: #{data.difficulty}
                div Теги: #{data.tags.join(', ')}
                div Автор: #{data.author_id.username}